# 配置清单示例；程序不自动加载 .env，请由启动环境注入这些键。
# 此示例只演示配置结构，不保证本机 MongoDB 或虚构模型提供方可用。
# 请勿提交真实凭据，也不要在日志中打印配置或连接 URI。
# 文本文件日志；SIZE 单位 MiB，ROLL 为备份数量，0 表示不限制数量。
CAGENT_LOG_LEVEL=info
CAGENT_LOG_PATH=/app/logs/cagent.log
CAGENT_LOG_SIZE=50
CAGENT_LOG_ROLL=3

CAGENT_HTTP_ADDRESS=127.0.0.1:8080
CAGENT_HTTP_SSE_HEARTBEAT=15s
CAGENT_HTTP_SHUTDOWN_GRACE=30s

# URI 必须显式设置。下面是无凭据的本地示例；数据库默认 cagent。
CAGENT_MONGODB_URI=mongodb://localhost:27017
CAGENT_MONGODB_DATABASE=cagent

# OpenAI 兼容 Chat Completions；模型、API 前缀、密钥须显式配置，不从 SDK 环境回退。
CAGENT_AGENT_NAME=cagent
CAGENT_AGENT_PROVIDER=openai
CAGENT_AGENT_MODEL=example-model
CAGENT_AGENT_BASE_URL=https://example.invalid/v1
CAGENT_AGENT_API_KEY=replace-with-real-key-in-environment
# 必须按实际模型选择编码；本地 BPE 估算仍需安全预留和真实 usage 校准。
CAGENT_AGENT_TOKEN_ENCODING=o200k_base
# 部分模型仅接受 max_completion_tokens，请按兼容端能力配置。
CAGENT_AGENT_MAX_TOKENS_FIELD=max_tokens
CAGENT_AGENT_REQUEST_TIMEOUT=2m

# 时间必须带单位且大于零；观察超时不限制远端任务寿命。
CAGENT_TASKS_POLL_INTERVAL=2s
CAGENT_TASKS_OBSERVATION_TIMEOUT=30s
CAGENT_TASKS_RECONNECT_BACKOFF=1s

# 根据真实模型能力调整窗口。窗口必须大于输出、工具和安全预留之和。
CAGENT_CONTEXT_WINDOW_TOKENS=8192
CAGENT_CONTEXT_OUTPUT_TOKENS=2048
CAGENT_CONTEXT_TOOL_TOKENS=1024
CAGENT_CONTEXT_SAFETY_TOKENS=512
CAGENT_CONTEXT_POLICY_VERSION=v1


# HTTP 认证固定 HS256，只需配置密钥；部署必须替换为随机秘密（至少 32 字节）。
CAGENT_HTTP_JWT_SECRET=replace-with-random-secret-at-least-32-bytes
CAGENT_HTTP_WRITE_TIMEOUT=10s
CAGENT_HTTP_MAX_BODY_BYTES=1048576
# 可选可信工具清单；空值禁用工具，示例见 docs/tools.example.json。
CAGENT_TOOLS_FILE=
# P10.1：0 禁用；默认在可用输入预算的 80% 触发，近期轮数包含当前轮。
CAGENT_CONTEXT_COMPRESSION_THRESHOLD_PERCENT=80
CAGENT_CONTEXT_KEEP_RECENT_ROUNDS=2
# 空值沿用主模型/编码；摘要与主模型使用相同端点、凭据、请求超时。
CAGENT_CONTEXT_SUMMARY_MODEL=
CAGENT_CONTEXT_SUMMARY_TOKEN_ENCODING=
CAGENT_CONTEXT_SUMMARY_WINDOW_TOKENS=8192
CAGENT_CONTEXT_SUMMARY_OUTPUT_TOKENS=512

# 单实例容量；满载立即 503，Retry-After: 1
CAGENT_CAPACITY_RUNS=64
CAGENT_CAPACITY_MODELS=16
CAGENT_CAPACITY_OBSERVATIONS=32
CAGENT_HTTP_MAX_SUBSCRIPTIONS=256
# 空值关闭运维接口；启用时使用独立的至少 32 字节随机凭据
CAGENT_HTTP_DIAGNOSTICS_TOKEN=
